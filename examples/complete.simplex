SIMPLEX: 0.6

DATA: User
  id: string
  name: string
  email: string
  role: "admin" | "member" | "guest"

DATA: AuthResult
  success: boolean
  user: User | null
  error: string | null

FUNCTION: authenticate(email, password) → AuthResult

RULES:
  - [R1] look up user by email
  - [R2] if user not found, return failure
  - [R3] verify password matches stored hash
  - [R4] if password invalid, return failure
  - [R5] return success with user data

DONE_WHEN:
  - [D1] valid credentials return user
  - [D2] invalid credentials return error
  - [D3] result always has either user or error, never both

EXAMPLES:
  - [E1] value: ("alice@example.com", "correct") → { success: true, user: User, error: null }
  - [E2] error: ("alice@example.com", "wrong") → { success: false, user: null, error: "Invalid password" }
  - [E3] error: ("unknown@example.com", "any") → { success: false, user: null, error: "User not found" }
  - [E4] error: (credentials while database unavailable) → { success: false, user: null, error: "Service temporarily unavailable" }
  - [E5] property: any authentication attempt → logs and responses contain no plaintext password

ERRORS:
  - [X1] user not found → "User not found"
  - [X2] invalid password → "Invalid password"
  - [X3] database unavailable → "Service temporarily unavailable"
  - any unhandled condition → fail with descriptive message

READS:
  - [A1] Database.users

COVERS:
  - E1 → R1, R3, R5, D1, D3, A1
  - E2 → R1, R3, R4, D2, D3, X2, A1
  - E3 → R1, R2, D2, D3, X1, A1
  - E4 → D2, D3, X3, A1
  - E5 → C1

CONSTRAINT: password_security
  - [C1] passwords are never logged or returned in responses
